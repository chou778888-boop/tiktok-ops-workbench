{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tiktok-ops-workbench",
  "compatibility_date": "2026-07-29",
  "pages_build_output_dir": "dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tiktok-ops-workbench",
      "database_id": "82e5741e-1c8a-4fd3-868e-2f98592b82a0"
    }
  ],
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tiktok-ops-workbench-preview",
          "database_id": "ad6152f0-2e35-4952-b3d4-74c0c9074e2d"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    },
    "production": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tiktok-ops-workbench",
          "database_id": "82e5741e-1c8a-4fd3-868e-2f98592b82a0"
        }
      ],
      "ai": {
        "binding": "AI"
      }
    }
  }
}
