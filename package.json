{
  "name": "tiktok-ops-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-cloudflare.mjs",
    "dev:cloudflare": "pnpm build && wrangler pages dev dist",
    "db:local:init": "wrangler d1 execute tiktok-ops-workbench --local --file=migrations/0001_init.sql",
    "deploy:cloudflare": "pnpm build && wrangler pages deploy dist"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "wrangler": "^4.26.1"
  }
}
